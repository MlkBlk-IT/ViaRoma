#!/bin/sh
# Hook pre-commit: no commit can contain a secret.
#
# Install once per clone:
#   git config core.hooksPath .githooks
#
# Rule: credentials NEVER go into a versioned file
# (config/accounts.yaml). They go to data/creds/ (gitignore) and the YAML
# only carries the credentials_ref.
set -e

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node missing, secret scan ignored (CI scan will run)"
  exit 0
fi

if ! node scripts/scan_secrets.mjs; then
  echo ""
  echo "COMMIT DENIED: A secret was detected in the commit files."
  echo "  - credentials go to data/creds/ (gitignore)"
  echo "  - config/accounts.yaml only carries credentials_ref: env:VAR | file:path"
  echo "  - fixes the source, does not deactivate the guardrail"
  echo ""
  exit 1
fi

exit 0
